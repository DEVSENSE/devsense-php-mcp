{
    "name": "devsense-php-mcp",
    "version": "1.0.19264",
    "description": "Devsense PHP MCP Server",
    "main": "dist/index.js",
    "bin": {
        "devsense-php-mcp": "dist/index.js"
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/DEVSENSE/devsense-php-mcp.git"
    },
    "clean-package": {
        "remove": [
            "clean-package",
            "scripts",
            "devDependencies"
        ]
    },
    "scripts": {
        "start": "npx tsx src/index.ts",
        "test": "npm run build && node --test",
        "prepack": "clean-package",
        "postpack": "clean-package restore",
        "build": "node build.js"
    },
    "author": "DEVSENSE",
    "license": "ISC",
    "keywords": [
        "cli",
        "php",
        "mcp",
        "agent",
        "ai"
    ],
    "dependencies": {
        "commander": "^13.1.0",
        "devsense-php-ls": "^1.0.19264",
        "devsense-php-ls-node": "^1.0.19264",
        "glob": "^14.0.4",
        "minimatch": "^11.0.8",
        "vscode-jsonrpc": "^8.2.1",
        "@modelcontextprotocol/sdk": "^1.32.2"
    },
    "devDependencies": {
        "@commander-js/extra-typings": "^13.1.0",
        "@types/node": "^22.13.17",
        "clean-package": "^2.2.0",
        "esbuild": "^0.25.2",
        "ts-loader": "^9.5.2",
        "ts-node": "^10.9.2",
        "tsx": "^4.19.3",
        "typescript": "^5.8.2"
    }
}
